# ORB-SLAM3 x86 container for edge-slam-benchmark (plan §10 / Phase 0).
# Classical — no CUDA/torch. Viewer disabled for headless batch runs.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget ca-certificates \
        libeigen3-dev libopencv-dev libgl1-mesa-dev libglew-dev \
        libpython3-dev python3-numpy libboost-all-dev \
        libssl-dev libepoxy-dev \
    && rm -rf /var/lib/apt/lists/*

# Pangolin (ORB-SLAM3 viewer dependency; we still link it but disable the UI at runtime)
WORKDIR /opt
RUN git clone --recursive https://github.com/stevenlovegrove/Pangolin.git \
    && cd Pangolin && git checkout v0.6 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF -DBUILD_TOOLS=OFF \
    && make -j"$(nproc)" && make install && ldconfig \
    && cd /opt && rm -rf Pangolin

ARG ORB_SLAM3_COMMIT=4452a3c4ab75b1cde34e5505a36ec3f9edcdc4c4
WORKDIR /opt
RUN git clone https://github.com/UZ-SLAMLab/ORB_SLAM3.git ORB_SLAM3 \
    && cd ORB_SLAM3 \
    && git checkout "${ORB_SLAM3_COMMIT}" \
    && sed -i 's/ORB_SLAM3::System::RGBD,true)/ORB_SLAM3::System::RGBD,false)/' \
           Examples/RGB-D/rgbd_tum.cc \
    && chmod +x build.sh \
    && ./build.sh \
    && ls -la Examples/RGB-D/rgbd_tum Vocabulary/ORBvoc.txt

WORKDIR /opt/ORB_SLAM3
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
